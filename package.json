{
  "name": "figma-edit-mcp",
  "description": "Figma Edit MCP - Connect AI coding assistants to Figma via Model Context Protocol",
  "version": "0.3.5",
  "module": "dist/server.js",
  "main": "dist/server.js",
  "bin": {
    "figma-edit-mcp": "dist/server.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "type": "module",
  "scripts": {
    "test": "bun test src/mcp_server/tests",
    "start": "bun run dist/server.js",
    "socket": "bun run src/socket.ts",
    "setup": "./scripts/setup.sh",
    "integrate": "./scripts/integrate.sh",
    "build": "tsup",
    "build:watch": "tsup --watch",
    "dev": "bun run build:watch",
    "plugin:build": "node src/figma_plugin/build.js",
    "plugin:watch": "node src/figma_plugin/build.js --watch",
    "build:all": "bun run build && bun run plugin:build",
    "pub:release": "bun run build && bun publish"
  },
  "devDependencies": {
    "@figma/plugin-typings": "1.125.0",
    "@types/bun": "1.3.13",
    "bun-types": "1.3.13",
    "esbuild": "0.28.0",
    "tsup": "8.5.1",
    "typescript": "6.0.3"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.13.1",
    "uuid": "14.0.0",
    "ws": "8.20.0",
    "zod": "3.22.4"
  }
}
